# =================================================================
# TRADITION IA — VARIABLES D'ENVIRONNEMENT VERCEL (OPENROUTER / NVIDIA)
# =================================================================
# 
# Sur Vercel (vercel.com → Projet → Settings → Environment Variables) :
#   Ajoutez ces variables :
#
#   1. OPENROUTER_API_KEY = sk-or-v1-... (votre clé OpenRouter)
#   2. OPENROUTER_MODEL   = nvidia/llama-3.1-nemotron-70b-instruct (optionnel)
#
# =================================================================

# ── CLÉ API OPENROUTER (openrouter.ai/keys) ───────────────────────
OPENROUTER_API_KEY=sk-or-v1-ta_cle_openrouter_ici

# ── MODÈLE NVIDIA (Optionnel, par défaut : nvidia/llama-3.1-nemotron-70b-instruct)
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct



