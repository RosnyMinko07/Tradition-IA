# =================================================================
# TRADITION IA — VARIABLES D'ENVIRONNEMENT VERCEL
# =================================================================
# 
# Pour configurer sur Vercel :
#   1. Va sur vercel.com → ton projet → Settings → Environment Variables
#   2. Ajoute les variables ci-dessous :
#      - DEEPSEEK_API_KEY = votre_cle_deepseek (sk-...)
#      - AI_PROVIDER = deepseek (optionnel, auto-détecté)
#   3. Va dans Deployments → clique sur "..." → Redeploy !
# =================================================================

# ── CHOIX DU FOURNISSEUR IA ──────────────────────────────────────
# "deepseek" pour DeepSeek (modèle deepseek-chat)
# "gemini" pour Google Gemini
# "openai" pour OpenAI
AI_PROVIDER=deepseek

# ── DEEPSEEK (Recommandé) ────────────────────────────────────────
# Obtiens ta clé sur : https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-ta_cle_deepseek_ici

# ── GOOGLE GEMINI (Optionnel) ────────────────────────────────────
# Obtiens ta clé sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ta_cle_gemini_ici

# ── OPENAI (Optionnel) ───────────────────────────────────────────
# Obtiens ta clé sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=ta_cle_openai_ici

